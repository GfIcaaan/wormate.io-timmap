
{
  "name": "wormate-timmap",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": ".",
    "run_worker_first": [
      "/pub/*",
      "/check",
      "/store",
      "/healthz",
      "/wormy",
      "/js/game.js"
    ]
  },
  "vars": {
    "TUNNEL_ORIGIN": "https://non-reserve-infinite-companion.trycloudflare.com"
  }
}
